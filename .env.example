# Copy this file to .env and fill in real values. Never commit .env.

# --- Gemini / Google GenAI ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Strategic model routing (Gemini 3 family) ---
MODEL_FAST=gemini-3.5-flash
MODEL_PRO=gemini-3.1-pro

# --- Local persistence ---
DATABASE_PATH=data/travel_agent.db

# --- Logging & tracing ---
LOG_LEVEL=INFO
LOG_FILE_PATH=data/logs/agent.jsonl
OTEL_EXPORTER=console

# --- Memory / context management ---
HISTORY_WINDOW_TURNS=20
SUMMARIZATION_TOKEN_THRESHOLD=4000
